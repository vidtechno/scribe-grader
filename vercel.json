{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/ielts-writing-task-1.html",
      "destination": "/ielts-writing-task-1",
      "permanent": true
    },
    {
      "source": "/ielts-writing-task-2.html",
      "destination": "/ielts-writing-task-2",
      "permanent": true
    },
    {
      "source": "/ielts-speaking-practice.html",
      "destination": "/ielts-speaking-practice",
      "permanent": true
    },
    {
      "source": "/blog/computer-based-ielts-writing",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/uz",
      "destination": "/uz/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/blog?feed=1"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/ielts-speaking-part-1",
      "destination": "/api/seo?kind=sp1"
    },
    {
      "source": "/ielts-speaking-part-1/:slug",
      "destination": "/api/seo?kind=sp1&slug=:slug"
    },
    {
      "source": "/ielts-speaking-part-2",
      "destination": "/api/seo?kind=sp2"
    },
    {
      "source": "/ielts-speaking-part-2/:slug",
      "destination": "/api/seo?kind=sp2&slug=:slug"
    },
    {
      "source": "/ielts-writing-task-2-questions",
      "destination": "/api/seo?kind=wt2"
    },
    {
      "source": "/ielts-writing-task-2-questions/:slug",
      "destination": "/api/seo?kind=wt2&slug=:slug"
    },
    {
      "source": "/ielts-speaking-part-3",
      "destination": "/api/seo?kind=sp3"
    },
    {
      "source": "/ielts-speaking-part-3/:slug",
      "destination": "/api/seo?kind=sp3&slug=:slug"
    },
    {
      "source": "/ielts-writing-task-1-samples",
      "destination": "/api/seo?kind=wt1"
    },
    {
      "source": "/ielts-writing-task-1-samples/:slug",
      "destination": "/api/seo?kind=wt1&slug=:slug"
    },
    {
      "source": "/ielts-vocabulary",
      "destination": "/api/seo?kind=vocab"
    },
    {
      "source": "/ielts-vocabulary/:slug",
      "destination": "/api/seo?kind=vocab&slug=:slug"
    },
    {
      "source": "/ielts-reading-practice",
      "destination": "/api/seo?kind=reading"
    },
    {
      "source": "/ielts-listening-practice",
      "destination": "/api/seo?kind=listening"
    },
    {
      "source": "/sitemap",
      "destination": "/api/seo?kind=map"
    },
    {
      "source": "/ielts-band-score-calculator",
      "destination": "/api/seo?kind=calc"
    },
    {
      "source": "/ingliz-tili-qoidalari",
      "destination": "/api/seo?kind=guide"
    },
    {
      "source": "/ingliz-tili-qoidalari/:slug",
      "destination": "/api/seo?kind=guide&slug=:slug"
    },
    {
      "source": "/inglizcha-sozlar",
      "destination": "/api/seo?kind=words"
    },
    {
      "source": "/inglizcha-sozlar/:slug",
      "destination": "/api/seo?kind=words&slug=:slug"
    },
    {
      "source": "/learn-english-from-uzbek",
      "destination": "/api/seo?kind=en-learn"
    },
    {
      "source": "/ingliz-tili-darslari",
      "destination": "/api/seo?kind=course"
    },
    {
      "source": "/ingliz-tili-darslari/:level",
      "destination": "/api/seo?kind=level&level=:level"
    },
    {
      "source": "/ingliz-tili-darslari/:level/:slug",
      "destination": "/api/seo?kind=lesson&level=:level&slug=:slug"
    },
    {
      "source": "/ielts-writing-task-1",
      "destination": "/ielts-writing-task-1.html"
    },
    {
      "source": "/ielts-writing-task-2",
      "destination": "/ielts-writing-task-2.html"
    },
    {
      "source": "/ielts-speaking-practice",
      "destination": "/ielts-speaking-practice.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/:file(.+\\.mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
