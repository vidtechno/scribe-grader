{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/ielts-writing-task-1.html",
      "destination": "/ielts-writing-task-1",
      "permanent": true
    },
    {
      "source": "/ielts-writing-task-2.html",
      "destination": "/ielts-writing-task-2",
      "permanent": true
    },
    {
      "source": "/ielts-speaking-practice.html",
      "destination": "/ielts-speaking-practice",
      "permanent": true
    },
    {
      "source": "/blog/computer-based-ielts-writing",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/blog?feed=1"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/ielts-speaking-part-1",
      "destination": "/api/seo?kind=sp1"
    },
    {
      "source": "/ielts-speaking-part-1/:slug",
      "destination": "/api/seo?kind=sp1&slug=:slug"
    },
    {
      "source": "/ielts-speaking-part-2",
      "destination": "/api/seo?kind=sp2"
    },
    {
      "source": "/ielts-speaking-part-2/:slug",
      "destination": "/api/seo?kind=sp2&slug=:slug"
    },
    {
      "source": "/ielts-writing-task-2-questions",
      "destination": "/api/seo?kind=wt2"
    },
    {
      "source": "/ielts-writing-task-2-questions/:slug",
      "destination": "/api/seo?kind=wt2&slug=:slug"
    },
    {
      "source": "/ielts-speaking-part-3",
      "destination": "/api/seo?kind=sp3"
    },
    {
      "source": "/ielts-speaking-part-3/:slug",
      "destination": "/api/seo?kind=sp3&slug=:slug"
    },
    {
      "source": "/ielts-writing-task-1-samples",
      "destination": "/api/seo?kind=wt1"
    },
    {
      "source": "/ielts-writing-task-1-samples/:slug",
      "destination": "/api/seo?kind=wt1&slug=:slug"
    },
    {
      "source": "/ielts-vocabulary",
      "destination": "/api/seo?kind=vocab"
    },
    {
      "source": "/ielts-vocabulary/:slug",
      "destination": "/api/seo?kind=vocab&slug=:slug"
    },
    {
      "source": "/ielts-band-score-calculator",
      "destination": "/api/seo?kind=calc"
    },
    {
      "source": "/ielts-writing-task-1",
      "destination": "/ielts-writing-task-1.html"
    },
    {
      "source": "/ielts-writing-task-2",
      "destination": "/ielts-writing-task-2.html"
    },
    {
      "source": "/ielts-speaking-practice",
      "destination": "/ielts-speaking-practice.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/audio/:file(.+\\.mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
