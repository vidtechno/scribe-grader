{"duration": 14.88, "marks": {"rows": 2.52, "r1": 2.52, "r2": 4.28, "r3": 6.32, "example": 9.57, "compare": 12.48, "fixed": 13.78}, "captions": [{"from": 0.0, "to": 2.52, "text": "Inglizcha gapda fe'l shart!"}, {"from": 2.52, "to": 4.28, "text": "Men — I am."}, {"from": 4.28, "to": 6.32, "text": "U — he is, she is."}, {"from": 6.32, "to": 9.57, "text": "Biz, ular — we are, they are."}, {"from": 9.57, "to": 12.48, "text": "Masalan: I am a student."}, {"from": 12.48, "to": 15.28, "text": "O'zbekcha: Men talabaman."}]}